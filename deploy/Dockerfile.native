FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates python3 gcc-aarch64-linux-gnu g++-aarch64-linux-gnu && rm -rf /var/lib/apt/lists/*
RUN git init /llama && git -C /llama remote add origin https://github.com/ggml-org/llama.cpp.git && git -C /llama fetch --depth=1 origin 838374375cb8c467c33c263be4801c19d1089763 && git -C /llama checkout --detach FETCH_HEAD
RUN cmake -S /llama -B /standard-build -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=aarch64 -DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF -DGGML_CPU_ARM_ARCH=armv8.2-a+fp16+dotprod -DGGML_CPU_ALL_VARIANTS=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON -DLLAMA_BUILD_TOOLS=ON -DLLAMA_BUILD_COMMON=ON -DLLAMA_BUILD_WEBUI=OFF -DLLAMA_CURL=OFF -DLLAMA_OPENSSL=OFF && cmake --build /standard-build --target llama-server -j2
COPY native /native
RUN cmake -S /native -B /native-build -DLLAMA_SOURCE_DIR=/llama -DLLAMA_LIBRARY_DIR=/standard-build/bin -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=aarch64 -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ -DCMAKE_BUILD_TYPE=Release && cmake --build /native-build -j2
COPY scripts/prepare_private_runtime.py /prepare_private_runtime.py
RUN python3 /prepare_private_runtime.py /llama /private
RUN cmake -S /private -B /private-build -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=aarch64 -DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF -DGGML_CPU_ARM_ARCH=armv8.2-a+fp16+dotprod -DGGML_CPU_ALL_VARIANTS=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=OFF -DLLAMA_BUILD_TOOLS=OFF -DLLAMA_BUILD_COMMON=OFF -DLLAMA_CURL=OFF && cmake --build /private-build --target llama -j2
RUN cmake -S /native -B /prefill-build -DLLAMA_SOURCE_DIR=/private -DLLAMA_LIBRARY_DIR=/private-build/bin -DBUILD_PRECISION=OFF -DBUILD_PREFILL=ON -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=aarch64 -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ -DCMAKE_BUILD_TYPE=Release && cmake --build /prefill-build -j2
RUN mkdir -p /out/standard /out/poc /out/reference /out/native && cp /standard-build/bin/llama-server /out/standard/ && cp -L /standard-build/bin/*.so* /out/standard/ && cp /native-build/qwen-route-worker /native-build/qwen-release-worker /native-build/u3-microbatch2-worker /native-build/test-qwen-math /native-build/test-qwen-attention /out/native/ && cp -L /standard-build/bin/*.so* /out/native/ && cp /prefill-build/attention-worker /out/poc/ && cp /prefill-build/attention-reference /out/reference/attention-worker && cp -L /private-build/bin/*.so* /out/poc/ && cp -L /private-build/bin/*.so* /out/reference/
RUN for directory in /out/standard /out/native /out/poc /out/reference; do cp -L /usr/aarch64-linux-gnu/lib/libstdc++.so.6 /usr/aarch64-linux-gnu/lib/libgcc_s.so.1 /usr/aarch64-linux-gnu/lib/libgomp.so.1 "$directory/"; done
FROM scratch AS artifacts
COPY --from=build /out/ /
